{
  "name": "dsh-plugin-qwen-image",
  "version": "0.3.0",
  "description": "DeepSeek Harness out-of-tree plugin: give a text-only coding model eyes by routing images to a Qwen-VL (DashScope) route through ctx.llm and returning text.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "qwen",
    "qwen-vl",
    "dashscope",
    "vision",
    "ocr",
    "multimodal",
    "text-only-llm",
    "image-to-text",
    "paste-image",
    "clipboard",
    "coding-agent"
  ],
  "author": "zjcdkj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjcdkj/dsh-plugins.git",
    "directory": "packages/qwen-image"
  },
  "bugs": {
    "url": "https://github.com/zjcdkj/dsh-plugins/issues"
  },
  "homepage": "https://github.com/zjcdkj/dsh-plugins/tree/main/packages/qwen-image#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
{
  "name": "dsh-plugin-session-resources",
  "version": "0.1.0",
  "description": "DeepSeek Harness out-of-tree plugin: a Resources tab listing the files one session produced and the files it consulted, folded from tool render intent rather than by scanning disk.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "artifacts",
    "deliverables",
    "provenance",
    "audit",
    "web-ui",
    "coding-agent"
  ],
  "author": "zjcdkj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjcdkj/dsh-plugins.git",
    "directory": "packages/session-resources"
  },
  "bugs": {
    "url": "https://github.com/zjcdkj/dsh-plugins/issues"
  },
  "homepage": "https://github.com/zjcdkj/dsh-plugins/tree/main/packages/session-resources#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}

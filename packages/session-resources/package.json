{
  "name": "dsh-plugin-session-resources",
  "version": "0.2.0",
  "description": "DeepSeek Harness out-of-tree plugin: a file panel beside the conversation — the session's workspace as a tree, the files it produced pinned above, and a mark on every row it touched.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "file-tree",
    "file-explorer",
    "workspace",
    "session",
    "artifacts",
    "deliverables",
    "provenance",
    "audit",
    "web-ui",
    "coding-agent"
  ],
  "author": "zjcdkj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjcdkj/dsh-plugins.git",
    "directory": "packages/session-resources"
  },
  "bugs": {
    "url": "https://github.com/zjcdkj/dsh-plugins/issues"
  },
  "homepage": "https://github.com/zjcdkj/dsh-plugins/tree/main/packages/session-resources#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}